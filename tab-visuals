-- Keybind toggle to show/hide target info on demand.
-- Key is required by the library — RightAlt is a low-conflict default.
local _tiBindTog = TargetBox:Toggle({Title = "bind toggle", Flag = "targetinfo_bind_tog", Default = false})
_tiBindTog:Keybind({
    Title     = "bind",
    Flag      = "targetinfo_bind",
    Key       = Enum.KeyCode.RightAlt,   -- ← Key is required, prevents the EnumType nil crash
    StateType = "Toggle",
    Callback  = function()
        -- toggling visibility is handled in the render loop below
    end
})

do
    local _UIS     = game:GetService("UserInputService")
    local _Players = game:GetService("Players")
    local _LP      = _Players.LocalPlayer
    local _showing = true

    local _tiDrawings = {}
    for i = 1, 6 do
        local d = Drawing.new("Text")
        d.Visible = false; d.Outline = true; d.Font = 3
        d.Color = Color3.fromRGB(255, 155, 205)
        d.OutlineColor = Color3.new(0, 0, 0)
        d.Center = true
        _tiDrawings[i] = d
    end

    local function _tiHideAll()
        for _, d in ipairs(_tiDrawings) do d.Visible = false end
    end

    local function _tiVisible(head)
        local origin = cam.CFrame.Position
        local dir    = head.Position - origin
        local rp     = RaycastParams.new()
        rp.FilterDescendantsInstances = {_LP.Character}
        rp.FilterType = Enum.RaycastFilterType.Blacklist
        local result = workspace:Raycast(origin, dir, rp)
        return result and result.Instance:IsDescendantOf(head.Parent)
    end

    local function _tiClosest()
        local mousePos = _UIS:GetMouseLocation()
        local closest, dist = nil, math.huge
        for _, plr in ipairs(_Players:GetPlayers()) do
            if plr ~= _LP and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local pos, onScreen = cam:WorldToViewportPoint(plr.Character.HumanoidRootPart.Position)
                if onScreen then
                    local d = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if d < dist then dist = d; closest = plr end
                end
            end
        end
        return closest
    end

    -- Toggle _showing when the keybind fires
    RunService.Heartbeat:Connect(function()
        if not Library.Flags["targetinfo_enabled"] then return end
        local bindState = Library.Flags["targetinfo_bind"]
        -- bindState flips each time the key is pressed (Toggle mode)
        -- we use it directly as the visible flag
        _showing = (bindState == nil) or bindState
    end)

    task.spawn(function()
        while true do
            task.wait(0.025)
            if not Library.Flags["targetinfo_enabled"] or not _showing then
                _tiHideAll(); continue
            end
            local target = _tiClosest()
            if not target or not target.Character then _tiHideAll(); continue end

            local head = target.Character:FindFirstChild("Head")
            local hum  = target.Character:FindFirstChildOfClass("Humanoid")
            local hrp  = target.Character:FindFirstChild("HumanoidRootPart")
            if not head or not hum or not hrp then _tiHideAll(); continue end

            local size    = Library.Flags["targetinfo_size"]    or 15
            local yOffset = Library.Flags["targetinfo_yoffset"] or 0
            local index   = 1

            local function push(text)
                local d = _tiDrawings[index]
                d.Size     = size
                d.Text     = tostring(text)
                d.Position = Vector2.new(
                    cam.ViewportSize.X / 2,
                    cam.ViewportSize.Y / 2 + yOffset + (index - 1) * (size + 2)
                )
                d.Color   = Color3.fromRGB(255, 155, 205)
                d.Visible = true
                index     = index + 1
            end

            for i = index, #_tiDrawings do _tiDrawings[i].Visible = false end

            if Library.Flags["targetinfo_name"]     then push(string.lower(target.Name)) end
            if Library.Flags["targetinfo_visible"]  then push(_tiVisible(head) and "visible" or "hidden") end
            if Library.Flags["targetinfo_moving"]   then
                local vel = hrp.Velocity
                push(Vector3.new(vel.X,0,vel.Z).Magnitude > 1 and "moving" or "still")
            end
            if Library.Flags["targetinfo_hp"]       then
                push(string.format("%d%%", math.clamp(hum.Health/hum.MaxHealth*100, 0, 100)))
            end
            if Library.Flags["targetinfo_holding"]  then
                local holding = "none"
                local h = target.Character:FindFirstChild("Holding", true)
                if h and h:IsA("ObjectValue") and h.Value then holding = string.lower(h.Value.Name) end
                push(holding)
            end
            if Library.Flags["targetinfo_distance"] then
                local studs = (cam.CFrame.Position - hrp.Position).Magnitude
                push(math.floor(studs * 0.28) .. "m")
            end

            for i = index, #_tiDrawings do _tiDrawings[i].Visible = false end
        end
    end)
end

local FreeCamSection = VisTab:Section("free cam", "Left")
do
    local UIS2 = game:GetService("UserInputService")
    local RS2  = game:GetService("RunService")
    local Players2 = game:GetService("Players")
    local LocalPlayer2 = Players2.LocalPlayer

    local _fcEnabled   = false
    local _fcConn      = nil
    local _fcSpeed     = 50
    local _fcShowDist  = true
    local _fcSensLabel = FreeCamSection:Label("speed: 50")

    local pitch, yaw = 0, 0
    local _fcCF        = nil
    local _fcPart      = nil   -- replication focus anchor
    local _fcGhost     = nil   -- clone of player's character left behind
    local _fcGhostLabel = nil  -- distance text drawing

    local function _fcCleanup()
        if _fcConn then _fcConn:Disconnect(); _fcConn = nil end
        cam.CameraType = Enum.CameraType.Custom
        pcall(function() LocalPlayer2.ReplicationFocus = nil end)
        if _fcPart then _fcPart:Destroy(); _fcPart = nil end
        if _fcGhostLabel then _fcGhostLabel:Remove(); _fcGhostLabel = nil end
        if _fcGhost then _fcGhost:Destroy(); _fcGhost = nil end
    end

    FreeCamSection:Toggle({Title = "enable free cam", Flag = "FreeCam", Default = false, Callback = function(s)
        _fcEnabled = s
        if s then
            _fcCF = cam.CFrame
            pitch, yaw = _fcCF:ToOrientation()
            cam.CameraType = Enum.CameraType.Scriptable

            -- anchor part so the server keeps streaming terrain/players around the cam
            _fcPart = Instance.new("Part")
            _fcPart.Anchored   = true
            _fcPart.CanCollide = false
            _fcPart.Transparency = 1
            _fcPart.Name = "FreeCamFocus"
            _fcPart.Parent = workspace.Terrain
            pcall(function() LocalPlayer2.ReplicationFocus = _fcPart end)

            -- leave a ghost copy of the character behind so others/your client still sees a body
            local char = LocalPlayer2.Character
            if char then
                local oldArchivable = char.Archivable
                char.Archivable = true
                local ok, ghost = pcall(function() return char:Clone() end)
                char.Archivable = oldArchivable
                if ok and ghost then
                    ghost.Name = "FreeCamGhost_ESP_IGNORE"
                    for _, desc in ipairs(ghost:GetDescendants()) do
                        if desc:IsA("BasePart") then
                            desc.CanCollide = false
                            desc.CanTouch   = false
                            desc.CanQuery   = false
                            desc.Massless   = true
                            desc.Anchored   = true
                        elseif desc:IsA("Script") or desc:IsA("LocalScript") then
                            desc:Destroy()
                        end
                    end
                    local hum = ghost:FindFirstChildOfClass("Humanoid")
                    if hum then hum:Destroy() end

                    local hrp = ghost:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local txt = Drawing.new("Text")
                        txt.Center  = true
                        txt.Outline = true
                        txt.Font    = 3
                        txt.Size    = Library.Flags["ESPFontSize"] or 13
                        txt.Color   = Color3.fromRGB(255, 255, 255)
                        txt.Visible = false
                        _fcGhostLabel = txt
                    end

                    ghost.Parent = workspace.Terrain
                    local realHrp = char:FindFirstChild("HumanoidRootPart")
                    if realHrp then ghost:PivotTo(realHrp.CFrame) end
                    _fcGhost = ghost
                end
            end

            local lastStream = 0
            _fcConn = RS2.RenderStepped:Connect(function(dt)
                if not _fcEnabled then
                    if _fcConn then _fcConn:Disconnect(); _fcConn = nil end
                    return
                end

                if UIS2:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                    UIS2.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
                    local delta = UIS2:GetMouseDelta()
                    pitch = math.clamp(pitch - delta.Y * 0.005, -math.pi/2 + 0.01, math.pi/2 - 0.01)
                    yaw   = yaw - delta.X * 0.005
                else
                    UIS2.MouseBehavior = Enum.MouseBehavior.Default
                end

                local move = Vector3.new()
                if UIS2:IsKeyDown(Enum.KeyCode.W) then move = move + Vector3.new(0,0,1) end
                if UIS2:IsKeyDown(Enum.KeyCode.S) then move = move + Vector3.new(0,0,-1) end
                if UIS2:IsKeyDown(Enum.KeyCode.A) then move = move + Vector3.new(-1,0,0) end
                if UIS2:IsKeyDown(Enum.KeyCode.D) then move = move + Vector3.new(1,0,0) end
                if UIS2:IsKeyDown(Enum.KeyCode.E) or UIS2:IsKeyDown(Enum.KeyCode.Space)      then move = move + Vector3.new(0,1,0) end
                if UIS2:IsKeyDown(Enum.KeyCode.Q) or UIS2:IsKeyDown(Enum.KeyCode.LeftControl) then move = move + Vector3.new(0,-1,0) end

                _fcCF = CFrame.new(_fcCF.Position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
                if move.Magnitude > 0 then
                    move = move.Unit
                    _fcCF = _fcCF + (_fcCF.RightVector * move.X + _fcCF.UpVector * move.Y + _fcCF.LookVector * move.Z) * (_fcSpeed * dt)
                end

                cam.CFrame = _fcCF

                if _fcPart then
                    _fcPart.CFrame = _fcCF
                    pcall(function() LocalPlayer2.ReplicationFocus = _fcPart end)
                    if tick() - lastStream > 1 then
                        lastStream = tick()
                        task.spawn(function()
                            pcall(function() LocalPlayer2:RequestStreamAroundAsync(_fcCF.Position) end)
                        end)
                    end
                end

                if _fcGhostLabel then
                    local char2 = LocalPlayer2.Character
                    local hrp2  = char2 and char2:FindFirstChild("HumanoidRootPart")
                    if hrp2 and _fcShowDist then
                        local dist = math.floor((hrp2.Position - _fcCF.Position).Magnitude * 0.28)
                        _fcGhostLabel.Text = "[" .. dist .. "m]"
                        _fcGhostLabel.Size = Library.Flags["ESPFontSize"] or 13
                        local pos, onScreen = cam:WorldToViewportPoint(hrp2.Position)
                        if onScreen then
                            _fcGhostLabel.Position = Vector2.new(pos.X, pos.Y)
                            _fcGhostLabel.Visible = true
                        else
                            _fcGhostLabel.Visible = false
                        end
                    else
                        _fcGhostLabel.Visible = false
                    end
                end

                -- keep your real character frozen in place while in freecam
                local char2 = LocalPlayer2.Character
                if char2 then
                    local root = char2:FindFirstChild("HumanoidRootPart")
                    if root then
                        root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
                    end
                    local hum2 = char2:FindFirstChildOfClass("Humanoid")
                    if hum2 then hum2:Move(Vector3.zero, false) end
                end
            end)
        else
            _fcCleanup()
        end
    end})

    FreeCamSection:Toggle({Title = "show distance esp", Flag = "FreeCamShowDist", Default = true, Callback = function(s)
        _fcShowDist = s
    end})

    FreeCamSection:Slider({Title = "speed", Flag = "FreeCamSpeed", Symbol = "", Default = 50, Min = 10, Max = 575, Decimals = 0, Callback = function(v)
        _fcSpeed = v; _fcSensLabel:Set("speed: "..v)
    end})
end

